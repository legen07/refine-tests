#!/usr/bin/env sh
# refine-tests — zero-install launcher (§17 usage examples).
# Runs the plugin's CLI from a checkout without `pip install -e .`.
# Invocable from any directory: PYTHONPATH anchors the module so relative
# targets resolve against *your* cwd, as every CLI should.
# Preference order: the checkout's .venv (see `refine-tests bootstrap`),
# then the interpreter on PATH.
set -e
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
PY="$ROOT/.venv/bin/python"
if [ ! -x "$PY" ]; then
  PY=python3
fi
PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" exec "$PY" -m src.cli "$@"
