# Local venv used by the zero-install launcher / fixture audit runs
.venv/

# Artifacts of auditing the fixture suite (target-root reports & caches)
src/tests/fixtures/refine-tests-report.*
src/tests/fixtures/.refine-tests-cov/
src/tests/fixtures/.pytest_cache/
src/tests/fixtures/**/__pycache__/

# Python build artifacts
__pycache__/
*.egg-info/
build/
dist/

# Editor
.idea/
.vscode/

# Cleanup outputs of acceptance/debug runs against the fixture suite
# (regenerated by src/tests/run_acceptance.py; never shipped)
src/tests/fixtures/quarantine/
src/tests/fixtures/proposed/

# Stray coverage data when auditing the plugin's own root
.coverage
.refine-tests-cov/
